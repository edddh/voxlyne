# Ascolta - Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# OpenAI Configuration (REQUIRED)
# ===========================================
OPENAI_API_KEY=sk-[REDACTED]
# Project ID for SIP routing (get from OpenAI dashboard)
OPENAI_PROJECT_ID=proj_your-project-id

# ===========================================
# PostgreSQL Database
# ===========================================
DATABASE_URL=postgresql://ascolta:change-me@postgres:5432/ascolta
USE_EXTERNAL_POSTGRES=0
POSTGRES_USER=ascolta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ascolta

# ===========================================
# Application Security
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-64-char-secret-key-here

# Admin credentials (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ===========================================
# Application Settings
# ===========================================
APP_ENV=development
LOG_LEVEL=INFO
# Public URL for webhooks (ngrok or production domain)
WEBHOOK_BASE_URL=https://your-domain.com

# ===========================================
# Zadarma SIP (Reference - configure in Zadarma dashboard)
# ===========================================
# ZADARMA_SIP_USER=your-sip-user
# Zadarma forwards calls to: sip:{OPENAI_PROJECT_ID}@sip.api.openai.com;transport=tls

# ===========================================
# M2: Storage (MinIO/S3)
# ===========================================
# S3-compatible storage for PDF files
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword-set-at-bootstrap
S3_BUCKET=ascolta
S3_REGION=us-east-1
# For production AWS S3, change S3_ENDPOINT to: https://s3.{region}.amazonaws.com

# Email (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=admin@example.test
# EMAIL_TO_DEFAULT=admin@example.test
# EMAIL_ENABLED=false

# ===========================================
# M5: Voice Engine API Keys (Global Fallback)
# ===========================================
# These are global fallback values. Projects can override via UI (M5.5)
# Configure project-specific credentials in: Admin Panel > Projects > API Credentials

# Vapi.ai (for outbound calls)
# VAPI_API_KEY=sk-...
# VAPI_PHONE_NUMBER_ID=...

# ElevenLabs (for TTS)
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# Twilio (for telephony)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+49...

# ===========================================
# M3: CRM Integration (Global Fallback)
# ===========================================
# HubSpot
# HUBSPOT_ACCESS_TOKEN=...
# HUBSPOT_API_KEY=...

# Generic Webhook
# WEBHOOK_SECRET=...

# Inbound webhook signature verification (opt-in - see app/config.py).
# Senza questi due, la firma dei webhook OpenAI/Vapi non viene verificata:
# impostarli solo dopo aver configurato lo stesso secret anche lato provider.
# OPENAI_WEBHOOK_SECRET=...
# VAPI_WEBHOOK_SECRET=...

# ===========================================
# M5: New Voice/Telephony Providers (Global Fallback)
# ===========================================
# Same pattern as above: these are global fallbacks. Tenants/projects can
# override via Admin Panel > Tenant/Project > Credentials (tenant-level
# resolution added in M5 - see CredentialsManager.get_credentials_with_fallback).

# xAI / Grok realtime voice
# XAI_API_KEY=...

# LiveKit (SIP trunk + agent worker dispatch)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# Zadarma SIP trunk credentials
# ZADARMA_SIP_LOGIN=...
# ZADARMA_SIP_PASSWORD=...
# ZADARMA_NUMBER=...

# ElevenLabs conversational agent (in addition to ELEVENLABS_API_KEY above)
# ELEVENLABS_TOOL_SECRET=...

# Cal.com scheduling
# CALCOM_API_KEY=...
